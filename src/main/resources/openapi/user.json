{
    "openapi": "3.0.3",
    "info": {
        "title": "Event Ticketing - User API",
        "description": "API for managing user accounts and authentication.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api/v1",
            "description": "Local development"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "security": [],
                "summary": "Register a customer account",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "./shared.json#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Account created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "./shared.json#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "./shared.json#/components/responses/BadRequest"
                    },
                    "409": {
                        "$ref": "./shared.json#/components/responses/Conflict"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "security": [],
                "summary": "Login",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "./shared.json#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "./shared.json#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "./shared.json#/components/responses/Unauthorized"
                    }
                }
            }
        }
    }
}
